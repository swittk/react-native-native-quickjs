{
  "name": "react-native-native-quickjs",
  "version": "0.1.0",
  "description": "Native vendored QuickJS runtime for React Native",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "vendor",
    "scripts",
    "codegenConfig.json",
    "react-native-native-quickjs.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!android/.cxx",
    "!ios/build",
    "!scripts/build",
    "!scripts/.gradle",
    "!scripts/**/.gradle",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "test:native": "bash scripts/test-native-core.sh",
    "prepare": "bob build",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods"
  },
  "keywords": [
    "react-native",
    "quickjs",
    "javascript",
    "embedded",
    "ios",
    "android"
  ],
  "repository": "https://github.com/swittk/react-native-native-quickjs",
  "author": "Switt Kongdachalert <swittssoftware@gmail.com> (https://swittssoftware.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/swittk/react-native-native-quickjs/issues"
  },
  "homepage": "https://github.com/swittk/react-native-native-quickjs#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.83.3",
    "@types/react": "^19.1.1",
    "pod-install": "^1.1.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.6"
  },
  "engines": {
    "node": ">=18"
  },
  "codegenConfig": {
    "name": "NativeQuickJS",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.reactnativenativequickjs"
    },
    "ios": {
      "modulesProvider": {
        "SKNativeQuickJS": "SKNativeQuickJS"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
